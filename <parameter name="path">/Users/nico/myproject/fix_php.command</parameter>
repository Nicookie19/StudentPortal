<parameter name="content">#!/bin/bash

# Fix PHP path after removing Herd
# Run this script in your terminal by double-clicking it

echo "Checking for alternative PHP installations..."

# Remove Herd paths from ~/.zshrc
echo "Removing Herd configurations from ~/.zshrc..."

# Backup original zshrc
cp ~/.zshrc ~/.zshrc.backup 2>/dev/null

# Remove Herd-related lines from zshrc
sed -i '' '/Herd/d' ~/.zshrc 2>/dev/null
sed -i '' '/Applications\/Herd/d' ~/.zshrc 2>/dev/null
sed -i '' '/.app\/Contents/d' ~/.zshrc 2>/dev/null

# Check for Homebrew PHP
if [ -f "/opt/homebrew/bin/php" ]; then
    echo "Adding Homebrew PHP to PATH..."
    # Remove any existing path additions for Homebrew PHP
    sed -i '' '/homebrew\/bin/d' ~/.zshrc 2>/dev/null
    
    # Add Homebrew PHP to the beginning of PATH
    echo 'export PATH="/opt/homebrew/bin:$PATH"' >> ~/.zshrc
    export PATH="/opt/homebrew/bin:$PATH"
    echo "Homebrew PHP added to PATH"
elif [ -f "/usr/local/bin/php" ]; then
    echo "Adding /usr/local/bin PHP to PATH..."
    # Remove any existing path additions
    sed -i '' '/usr\/local\/bin/d' ~/.zshrc 2>/dev/null
    
    # Add to PATH
    echo 'export PATH="/usr/local/bin:$PATH"' >> ~/.zshrc
    export PATH="/usr/local/bin:$PATH"
    echo "PHP added to PATH"
else
    echo "No alternative PHP found."
    echo "Installing PHP with Homebrew..."
    if command -v brew &> /dev/null; then
        brew install php
        echo 'export PATH="/opt/homebrew/bin:$PATH"' >> ~/.zshrc
        export PATH="/opt/homebrew/bin:$PATH"
    else
        echo "Homebrew not found. Please install Homebrew first or reinstall Herd."
        exit 1
    fi
fi

echo ""
echo "Source updated! Run this command in a new terminal:"
echo "   source ~/.zshrc"
echo ""
echo "Then try: php -v"
</parameter>
